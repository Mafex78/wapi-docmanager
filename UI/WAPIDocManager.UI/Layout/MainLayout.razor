@inherits LayoutComponentBase
@* l'uscita è l'unico punto in cui il layout usa un servizio di una funzionalità: dichiarazione locale, non globale *@
@using WAPIDocManager.UI.Features.Auth.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

@*
    Layout di tutte le pagine autenticate.
    - Menu laterale fisso sugli schermi grandi, a scomparsa su quelli stretti; si richiude toccando fuori o
      navigando.
    - Barra superiore: lingua, tema, utente corrente e uscita.
    - L'uscita pulisce la sessione locale e porta subito alla pagina di accesso.
    - Il contenuto della pagina è protetto da una barriera: un'eccezione non gestita mostra un messaggio al posto
      della sola pagina, lasciando funzionanti menu e barra superiore, invece della banda d'errore predefinita che
      blocca tutto. Si azzera riprovando e a ogni navigazione.
      Non riguarda gli errori delle API, che ogni pagina gestisce da sé, né le operazioni avviate senza attenderne
      l'esito. L'eccezione resta comunque scritta nella console del browser.
*@

<div class="app-shell @(_navOpen ? "nav-open" : null)">
    <aside class="app-sidebar" id="app-sidebar">
        <a class="app-brand" href="@AppRoutes.PageRelativeUrls.Documents">
            <span class="app-brand-mark" aria-hidden="true">W</span>
            <span>@L["App_Name"]</span>
        </a>
        <NavMenu OnNavigate="CloseNav" />
    </aside>
    <div class="app-sidebar-backdrop" @onclick="CloseNav"></div>

    <div class="app-main">
        <header class="app-topbar">
            <button type="button"
                    class="app-icon-btn app-nav-toggle"
                    aria-controls="app-sidebar"
                    aria-expanded="@(_navOpen ? "true" : "false")"
                    aria-label="@L["Nav_Toggle"]"
                    @onclick="ToggleNav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <div class="app-topbar-spacer"></div>
            <CultureSelector />
            <ThemeToggle />
            <AuthorizeView>
                <Authorized>
                    <div class="app-user">
                        <span class="app-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                        <span class="app-user-email">@context.User.Identity?.Name</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">@L["Auth_Logout"]</button>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="app-content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger app-alert" role="alert">
                        <div class="fw-semibold">@L["Error_Unexpected"]</div>
                        <div class="app-alert-detail">@L["Error_UnexpectedHint"]</div>
                        <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="Recover">@L["Action_Retry"]</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private bool _navOpen;
    private ErrorBoundary? _errorBoundary;

    // a ogni navigazione il layout riceve un nuovo Body: si riparte senza l'errore della pagina precedente
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    // "Riprova": la pagina viene ricreata da zero (se l'errore si ripete, il messaggio ricompare)
    private void Recover()
    {
        _errorBoundary?.Recover();
    }

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo(AppRoutes.PageRelativeUrls.Login);
    }

    private static string Initial(string? name)
    {
        return string.IsNullOrWhiteSpace(name) ? "?" : name[..1];
    }
}
