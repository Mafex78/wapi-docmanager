@inherits LayoutComponentBase

@*
    Layout minimo per le pagine raggiungibili senza essere autenticati: niente menu laterale, solo la scelta di
    lingua e tema in alto a destra e il contenuto centrato.
*@

<div class="app-auth">
    <div class="app-auth-toolbar">
        <CultureSelector />
        <ThemeToggle />
    </div>
    <main class="app-auth-content">
        @Body
    </main>
</div>
