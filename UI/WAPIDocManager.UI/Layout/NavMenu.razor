@*
    Menu laterale. Le voci sono filtrate per ruolo con gli stessi criteri degli attributi delle pagine: chi non può
    entrare in una pagina non ne vede nemmeno la voce.
    - Il confronto sull'indirizzo è esatto, altrimenti la voce dei documenti risulterebbe attiva anche stando sulla
      pagina di creazione.
    - La segnalazione della navigazione serve al layout per richiudere il menu sugli schermi stretti.
    - Le icone sono disegnate qui: non è inclusa nessuna libreria di icone.
    Per aggiungere una voce servono il collegamento e, se la pagina richiede un ruolo, il filtro corrispondente.
*@
<nav class="app-nav" aria-label="@L["App_Name"]">
    <div class="app-nav-section">@L["Nav_Section_Documents"]</div>

    <NavLink class="app-nav-link" href="@AppRoutes.PageRelativeUrls.Documents" Match="NavLinkMatch.All" @onclick="OnNavigate">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
            <path d="M14 3v5h5M9 13h6M9 17h6" />
        </svg>
        <span>@L["Nav_Documents"]</span>
    </NavLink>

    <AuthorizeView Roles="@AppRoles.Writers">
        <NavLink class="app-nav-link" href="@AppRoutes.PageRelativeUrls.DocumentNew" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            <span>@L["Nav_NewDocument"]</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.Admin">
        <div class="app-nav-section">@L["Nav_Section_Admin"]</div>
        <NavLink class="app-nav-link" href="@AppRoutes.PageRelativeUrls.UserRegister" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="8" r="4" />
                <path d="M2 21a7 7 0 0 1 14 0M19 8v6M16 11h6" />
            </svg>
            <span>@L["Nav_RegisterUser"]</span>
        </NavLink>
    </AuthorizeView>
</nav>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
}
