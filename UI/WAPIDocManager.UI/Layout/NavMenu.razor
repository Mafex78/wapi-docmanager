@*
    Menu laterale. Le voci sono filtrate per ruolo con AuthorizeView (costanti AppRoles), come gli attributi delle pagine.
    - Match="NavLinkMatch.All": evita che "Documenti" risulti attivo anche su /documents/new.
    - OnNavigate: il layout lo usa per chiudere la sidebar su mobile.
    - Icone SVG inline: non è inclusa nessuna libreria di icone (di Bootstrap si usa solo il CSS).
    Per aggiungere una pagina: NavLink con classe app-nav-link e href da AppRoutes (Shared/Navigation),
    dentro AuthorizeView se richiede un ruolo.
*@
<nav class="app-nav" aria-label="@L["App_Name"]">
    <div class="app-nav-section">@L["Nav_Section_Documents"]</div>

    <NavLink class="app-nav-link" href="@AppRoutes.Documents" Match="NavLinkMatch.All" @onclick="OnNavigate">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
            <path d="M14 3v5h5M9 13h6M9 17h6" />
        </svg>
        <span>@L["Nav_Documents"]</span>
    </NavLink>

    <AuthorizeView Roles="@AppRoles.Writers">
        <NavLink class="app-nav-link" href="@AppRoutes.DocumentNew" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            <span>@L["Nav_NewDocument"]</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.Admin">
        <div class="app-nav-section">@L["Nav_Section_Admin"]</div>
        <NavLink class="app-nav-link" href="@AppRoutes.UserRegister" Match="NavLinkMatch.All" @onclick="OnNavigate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="8" r="4" />
                <path d="M2 21a7 7 0 0 1 14 0M19 8v6M16 11h6" />
            </svg>
            <span>@L["Nav_RegisterUser"]</span>
        </NavLink>
    </AuthorizeView>
</nav>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
}
