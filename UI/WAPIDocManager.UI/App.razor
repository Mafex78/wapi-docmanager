@*
    Instradamento e autorizzazione delle pagine.
    - Gli attributi di autorizzazione dichiarati sulle pagine vengono applicati qui, leggendo lo stato di
      autenticazione dell'applicazione.
    - Chi non è autorizzato riceve due trattamenti diversi, ed è una distinzione voluta: l'utente anonimo viene
      mandato ad autenticarsi, conservando l'indirizzo che voleva raggiungere; quello già autenticato ma senza il
      ruolo necessario riceve un rifiuto esplicito, perché mandarlo di nuovo ad autenticarsi non risolverebbe nulla.
    - Il layout predefinito è quello delle pagine autenticate; una pagina può sceglierne un altro, come fa quella di
      accesso.
    - Dopo ogni navigazione il fuoco della tastiera va sul titolo della nuova pagina, per l'accessibilità.
*@
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <AccessDenied />
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <LoadingSpinner />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@L["NotFound_Title"] · @L["App_Name"]</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <section class="app-card app-empty">
                <h1 class="app-title">@L["NotFound_Title"]</h1>
                <p class="app-subtitle">@L["NotFound_Message"]</p>
                <a class="btn btn-primary mt-3" href="@AppRoutes.PageRelativeUrls.Documents">@L["Nav_Documents"]</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
