@inject IJSRuntime JS
@inject NavigationManager Navigation

@*
    Selettore della lingua.
    Salva la scelta fra le preferenze del browser e ricarica la pagina, perché la lingua si applica solo all'avvio
    dell'applicazione. La sessione sopravvive al ricaricamento; i filtri dell'elenco documenti no.
*@

<select class="form-select form-select-sm app-culture-select" aria-label="@L["Culture_Label"]" value="@CultureInfo.CurrentUICulture.Name" @onchange="ChangeAsync">
    @foreach (AppCulture culture in AppCultures.Supported)
    {
        <option value="@culture.Name">@culture.DisplayName</option>
    }
</select>

@code {
    private async Task ChangeAsync(ChangeEventArgs args)
    {
        string? cultureName = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(cultureName) || cultureName == CultureInfo.CurrentUICulture.Name)
        {
            return;
        }

        await JS.InvokeVoidAsync("wapiPreferences.setCulture", cultureName);

        // in WebAssembly la cultura si applica all'avvio: ricarica la pagina
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
