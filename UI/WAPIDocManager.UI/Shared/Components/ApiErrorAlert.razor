@using System.Net

@*
    Messaggio di errore standard per le chiamate alle API. Non mostra nulla quando non c'è niente da segnalare.
    Dall'errore si ricava un titolo tradotto, diverso a seconda dello status oppure dell'impossibilità di
    raggiungere il servizio; sotto compare il messaggio del server così come arriva, quindi in inglese.
    Un messaggio passato dall'esterno sostituisce entrambi, e serve quando la pagina sa spiegare meglio l'errore
    all'utente — per esempio delle credenziali sbagliate.
    Il pulsante di chiusura appare solo se il chiamante gestisce la chiusura, perché è la pagina a dover azzerare
    il proprio errore.
*@

@if (Error is not null || !string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-danger app-alert" role="alert">
        <div class="fw-semibold">@Title</div>
        @if (Detail is not null)
        {
            <div class="app-alert-detail">@Detail</div>
        }
        @if (OnDismiss.HasDelegate)
        {
            <button type="button" class="btn-close" aria-label="@L["Action_Close"]" @onclick="OnDismiss"></button>
        }
    </div>
}

@code {
    /// Errore da mostrare, qualunque sia la sua natura.
    [Parameter] public Exception? Error { get; set; }

    /// Testo che sostituisce il titolo ricavato dall'errore.
    [Parameter] public string? Message { get; set; }

    [Parameter] public EventCallback OnDismiss { get; set; }

    private string Title
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Message))
            {
                return Message;
            }

            return Error switch
            {
                ApiException { StatusCode: HttpStatusCode.BadRequest } => L["Error_BadRequest"].Value,
                ApiException { StatusCode: HttpStatusCode.Unauthorized } => L["Error_Unauthorized"].Value,
                ApiException { StatusCode: HttpStatusCode.Forbidden } => L["Error_Forbidden"].Value,
                ApiException { StatusCode: HttpStatusCode.NotFound } => L["Error_NotFound"].Value,
                HttpRequestException => L["Error_Network"].Value,
                _ => L["Error_Unexpected"].Value
            };
        }
    }

    // il messaggio restituito dalle API è in inglese e viene mostrato così come arriva
    private string? Detail => string.IsNullOrWhiteSpace(Message) ? (Error as ApiException)?.Detail : null;
}
