@*
    Finestra modale: usa il markup e gli stili di Bootstrap, ma non il suo JavaScript, che non è incluso nel
    progetto. La visibilità è quindi interamente nelle mani del chiamante, che deve richiuderla da sé quando la
    finestra segnala la chiusura — sia dal tasto Esc sia dalla X.
    Limiti noti: il fuoco della tastiera può uscire dalla finestra, e la pagina sottostante resta scorrevole.
*@
@if (IsOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show app-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onkeydown="OnKeyDown">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable @(Size is null ? null : $"modal-{Size}")">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="@_titleId">@Title</h2>
                    <button type="button" class="btn-close" aria-label="@L["Action_Close"]" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                @if (FooterContent is not null)
                {
                    <div class="modal-footer">
                        @FooterContent
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";

    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public string? Title { get; set; }

    /// Dimensione opzionale della finestra: sm, lg oppure xl.
    [Parameter] public string? Size { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? FooterContent { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }
}
