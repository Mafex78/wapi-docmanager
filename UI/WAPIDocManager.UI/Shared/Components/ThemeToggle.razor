@inject IJSRuntime JS

@*
    Pulsante di passaggio fra tema chiaro e scuro.
    Il tema è un attributo sul documento, impostato già al caricamento della pagina dalla preferenza salvata, o in
    sua assenza dal tema di sistema. Qui lo si legge e lo si cambia, e il nuovo valore viene salvato fra le
    preferenze del browser.
    Il cambio non ridisegna nessun componente: tutti i colori sono definiti in CSS e reagiscono da soli
    all'attributo.
*@

<button type="button" class="app-icon-btn" title="@Label" aria-label="@Label" @onclick="ToggleAsync">
    @if (_theme == DarkTheme)
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
    }
</button>

@code {
    private const string DarkTheme = "dark";
    private const string LightTheme = "light";

    private string _theme = LightTheme;

    private string Label => _theme == DarkTheme ? L["Theme_ToLight"] : L["Theme_ToDark"];

    protected override async Task OnInitializedAsync()
    {
        _theme = await JS.InvokeAsync<string>("wapiPreferences.getTheme");
    }

    private async Task ToggleAsync()
    {
        _theme = _theme == DarkTheme ? LightTheme : DarkTheme;
        await JS.InvokeVoidAsync("wapiPreferences.setTheme", _theme);
    }
}
