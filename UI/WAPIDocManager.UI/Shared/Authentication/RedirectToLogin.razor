@inject NavigationManager Navigation

@*
    Manda l'utente anonimo alla pagina di accesso conservando l'indirizzo che stava chiedendo, così da potervelo
    riportare una volta entrato.
    La navigazione sostituisce la voce nella cronologia: altrimenti il tasto Indietro riporterebbe alla pagina
    protetta, e da lì di nuovo qui.
*@

@code {
    protected override void OnInitialized()
    {
        string returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo(AppRoutes.LoginWithReturnUrl(returnUrl), replace: true);
    }
}
