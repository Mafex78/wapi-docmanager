@*
    Contrassegno colorato dello stato del documento.
    La classe CSS è costruita dal nome dello stato in minuscolo, e i colori sono definiti nel foglio di stile per
    entrambi i temi. Aggiungere uno stato richiede quindi tre cose oltre al valore: la classe, i due colori e la
    chiave di traduzione.
*@
<span class="app-badge @($"app-badge-{Status.ToString().ToLowerInvariant()}")">@L.Label(Status)</span>

@code {
    [Parameter, EditorRequired] public DocumentStatus Status { get; set; }
}
