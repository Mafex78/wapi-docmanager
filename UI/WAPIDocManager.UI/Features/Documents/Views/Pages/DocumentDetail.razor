@attribute [Route(AppRoutes.Templates.DocumentDetail)]
@attribute [Authorize(Roles = AppRoles.Readers)]
@using WAPIDocManager.UI.Features.Documents.ViewModels
@* la base di Blazing.Mvvm inietta il ViewModel come ViewModel e ridisegna la pagina a ogni notifica *@
@inherits Blazing.Mvvm.Components.MvvmComponentBase<DocumentDetailViewModel>

@*
    Dettaglio documento: punto di accesso a quasi tutti gli endpoint di WAPIDocument.
    - Logica in DocumentDetailViewModel (stessa cartella della view): caricamento, avanzamento stato, generazione,
      collegamento, eliminazione e caricamento dei documenti collegati. Qui restano markup, permessi e testi.
    - Lettura: GET api/v1/documents/{id} (ruoli Viewer, Editor, Admin). Le azioni di scrittura sono visibili secondo
      DocumentPermissions (Editor, Admin) e DocumentRules (stato).
    - Avanzamento stato: un pulsante per ogni stato di DocumentRules.GetNextStatuses (PUT .../status). L'avviso
      "documento incompleto" è solo informativo: l'eventuale 400 del server viene mostrato in ApiErrorAlert.
    - Genera (POST .../generation): tipo proposto Quote → Proforma, altrimenti SalesOrder; il backend non vincola lo stato
      del sorgente. La navigazione al nuovo documento è nel code-behind, in base all'esito del ViewModel.
    - Collega (POST .../attachments): modale con ricerca paginata, esclusi il documento stesso e quelli già collegati.
    - Elimina (DELETE): modale di conferma, poi ritorno alla lista.
    - Documenti collegati: il DTO dei link contiene solo l'Id, quindi il ViewModel esegue un GET in parallelo per ciascuno;
      quelli non leggibili (es. eliminati) vengono mostrati come "non disponibile".
    - Route e link da AppRoutes (Shared/Navigation).
    - Codice del componente (ruoli, titolo, messaggi, navigazione) in DocumentDetail.razor.cs.
*@

<PageTitle>@PageTitleText · @L["App_Name"]</PageTitle>

<div class="app-back"><a href="@AppRoutes.Documents">← @L["Action_Back"]</a></div>

@if (ViewModel.IsLoading)
{
    <LoadingSpinner />
}
else if (ViewModel.Document is null)
{
    <ApiErrorAlert Error="ViewModel.Error" />
}
else
{
    <div class="app-page-header">
        <div>
            <div class="app-eyebrow">@L.Label(ViewModel.Document.Type)</div>
            <h1 class="app-title d-flex flex-wrap align-items-center gap-2">
                <span class="app-mono">@DisplayFormat.ShortNumber(ViewModel.Document.Number)</span>
                <StatusBadge Status="ViewModel.Document.Status" />
            </h1>
        </div>
        <div class="app-toolbar">
            @if (DocumentPermissions.CanEdit(_roles, ViewModel.Document.Status))
            {
                <a class="btn btn-outline-primary" href="@AppRoutes.DocumentEdit(ViewModel.Document.Id)">@L["Action_Edit"]</a>
            }
            @if (DocumentPermissions.CanWrite(_roles))
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.ShowGenerate = true">@L["Action_Generate"]</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@ViewModel.IsBusy" @onclick="ViewModel.OpenAttachAsync">@L["Action_Attach"]</button>
            }
            @if (DocumentPermissions.CanDelete(_roles, ViewModel.Document.Status))
            {
                <button type="button" class="btn btn-outline-danger" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.ConfirmDelete = true">@L["Action_Delete"]</button>
            }
        </div>
    </div>

    <ApiErrorAlert Error="ViewModel.Error" OnDismiss="() => ViewModel.Error = null" />

    @if (NotificationMessage is not null)
    {
        <div class="alert alert-success app-alert" role="status">
            @NotificationMessage
            <button type="button" class="btn-close" aria-label="@L["Action_Close"]" @onclick="ViewModel.ClearNotification"></button>
        </div>
    }

    @if (DocumentPermissions.CanChangeStatus(_roles, ViewModel.Document.Status))
    {
        <section class="app-card app-status-card">
            <div>
                <h2 class="app-section-title mb-1">@L["Document_Workflow"]</h2>
                <p class="app-hint mb-0">
                    @(ViewModel.Document.Status == DocumentStatus.Draft && !DocumentRules.IsComplete(ViewModel.Document)
                        ? L["Document_IncompleteWarning"]
                        : L["Document_WorkflowHint"])
                </p>
            </div>
            <div class="app-toolbar">
                @foreach (DocumentStatus nextStatus in DocumentRules.GetNextStatuses(ViewModel.Document.Status))
                {
                    <button type="button"
                            class="btn @(nextStatus == DocumentStatus.Rejected ? "btn-outline-danger" : "btn-primary")"
                            disabled="@ViewModel.IsBusy"
                            @onclick="() => ViewModel.ChangeStatusAsync(nextStatus)">
                        @L.StatusActionLabel(nextStatus)
                    </button>
                }
            </div>
        </section>
    }

    <section class="app-card">
        <h2 class="app-section-title">@L["Document_Details"]</h2>
        <dl class="app-dl">
            <div><dt>@L["Field_Number"]</dt><dd class="app-mono">@DisplayFormat.OrDash(ViewModel.Document.Number)</dd></div>
            <div><dt>@L["Field_Type"]</dt><dd>@L.Label(ViewModel.Document.Type)</dd></div>
            <div><dt>@L["Field_Date"]</dt><dd>@DisplayFormat.Date(ViewModel.Document.Date)</dd></div>
            <div><dt>@L["Field_Currency"]</dt><dd>@L["Common_CurrencyValue"]</dd></div>
            <div><dt>@L["Field_Total"]</dt><dd class="app-amount">@DisplayFormat.Money(ViewModel.Document.Total)</dd></div>
        </dl>
    </section>

    <section class="app-card">
        <h2 class="app-section-title">@L["Document_Customer"]</h2>
        <dl class="app-dl">
            <div><dt>@L["Field_CustomerName"]</dt><dd>@DisplayFormat.OrDash(ViewModel.Document.Customer.Name)</dd></div>
            <div><dt>@L["Field_VatNumber"]</dt><dd>@DisplayFormat.OrDash(ViewModel.Document.Customer.VatNumber)</dd></div>
            <div><dt>@L["Field_Email"]</dt><dd>@DisplayFormat.OrDash(ViewModel.Document.Customer.Email)</dd></div>
            <div><dt>@L["Field_Address"]</dt><dd>@DisplayFormat.OrDash(ViewModel.Document.Customer.Address)</dd></div>
        </dl>
    </section>

    <section class="app-card app-card-flush">
        <h2 class="app-section-title app-card-header">@L["Document_Lines"]</h2>
        @if (ViewModel.Document.Lines.Count == 0)
        {
            <div class="app-empty">@L["Lines_Empty"]</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table app-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">@L["Field_Description"]</th>
                            <th scope="col" class="text-end">@L["Field_Quantity"]</th>
                            <th scope="col" class="text-end">@L["Field_UnitPrice"]</th>
                            <th scope="col" class="text-end">@L["Field_Total"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DocumentLine line in ViewModel.Document.Lines)
                        {
                            <tr>
                                <td>@DisplayFormat.OrDash(line.Description)</td>
                                <td class="text-end">@line.Quantity.ToString("0.##", CultureInfo.CurrentCulture)</td>
                                <td class="text-end text-nowrap">@DisplayFormat.Money(line.UnitPrice)</td>
                                <td class="text-end text-nowrap">@DisplayFormat.Money(line.Total)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="3" class="text-end">@L["Field_DocumentTotal"]</th>
                            <th class="text-end text-nowrap">@DisplayFormat.Money(ViewModel.Document.Total)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="app-card app-card-flush">
        <h2 class="app-section-title app-card-header">@L["Document_LinkedDocuments"]</h2>
        @if (ViewModel.Document.LinkedDocuments.Count == 0)
        {
            <div class="app-empty">@L["Document_LinkedEmpty"]</div>
        }
        else if (ViewModel.IsLoadingLinks)
        {
            <LoadingSpinner />
        }
        else
        {
            <ul class="app-list">
                @foreach ((DocumentLink link, Document? linked) in ViewModel.GetLinkedRows())
                {
                    <li class="app-list-item" @key="link.TargetDocumentId">
                        @if (linked is null)
                        {
                            <span class="app-mono">@link.TargetDocumentId</span>
                            <span class="app-hint">@L["Common_NotAvailable"]</span>
                        }
                        else
                        {
                            <a class="app-mono fw-semibold" href="@AppRoutes.DocumentDetail(linked.Id)" title="@linked.Number">@DisplayFormat.ShortNumber(linked.Number)</a>
                            <span>@L.Label(linked.Type)</span>
                            <span class="app-hint">@DisplayFormat.OrDash(linked.Customer.Name)</span>
                            <StatusBadge Status="linked.Status" />
                            <span class="ms-auto text-nowrap">@DisplayFormat.Money(linked.Total)</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <ModalDialog IsOpen="ViewModel.ConfirmDelete" Title="@L["Delete_Title"]" OnClose="() => ViewModel.ConfirmDelete = false">
        <ChildContent>
            <p class="mb-0">@L["Delete_Message", DisplayFormat.ShortNumber(ViewModel.Document.Number)]</p>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => ViewModel.ConfirmDelete = false">@L["Action_Cancel"]</button>
            <button type="button" class="btn btn-danger" disabled="@ViewModel.IsBusy" @onclick="DeleteAsync">@L["Action_Delete"]</button>
        </FooterContent>
    </ModalDialog>

    <ModalDialog IsOpen="ViewModel.ShowGenerate" Title="@L["Generate_Title"]" OnClose="() => ViewModel.ShowGenerate = false">
        <ChildContent>
            <p>@L["Generate_Message"]</p>
            <label class="form-label" for="generate-type">@L["Generate_TargetType"]</label>
            <select id="generate-type" class="form-select" @bind="ViewModel.GenerateType">
                @foreach (DocumentType type in Enum.GetValues<DocumentType>())
                {
                    <option value="@type">@L.Label(type)</option>
                }
            </select>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => ViewModel.ShowGenerate = false">@L["Action_Cancel"]</button>
            <button type="button" class="btn btn-primary" disabled="@ViewModel.IsBusy" @onclick="GenerateAsync">@L["Action_Generate"]</button>
        </FooterContent>
    </ModalDialog>

    <ModalDialog IsOpen="ViewModel.ShowAttach" Title="@L["Attach_Title"]" Size="lg" OnClose="() => ViewModel.ShowAttach = false">
        <ChildContent>
            <p class="app-hint">@L["Attach_Message"]</p>
            <form class="row g-2 mb-3" @onsubmit="() => ViewModel.SearchAttachCommand.ExecuteAsync(null)">
                <div class="col-sm-5">
                    <input class="form-control" aria-label="@L["Attach_SearchNumber"]" placeholder="@L["Attach_SearchNumber"]" @bind="ViewModel.AttachFilter.PlainText" @bind:event="oninput" />
                </div>
                <div class="col-sm-5">
                    <input class="form-control" aria-label="@L["Attach_SearchCustomer"]" placeholder="@L["Attach_SearchCustomer"]" @bind="ViewModel.AttachFilter.CustomerName" @bind:event="oninput" />
                </div>
                <div class="col-sm-2 d-grid">
                    @* disabled da CanExecute: mentre la ricerca è in corso il comando non è eseguibile, così non
                       si sovrappongono due chiamate come poteva accadere prima (il pulsante non era disabilitato) *@
                    <button type="submit" class="btn btn-outline-primary" disabled="@(!ViewModel.SearchAttachCommand.CanExecute(null))">@L["Action_Search"]</button>
                </div>
            </form>

            <ApiErrorAlert Error="ViewModel.AttachError" />

            @{
                // calcolata una sola volta per render: GetAttachCandidates filtra e costruisce una nuova lista a ogni chiamata
                IReadOnlyList<Document> attachCandidates = ViewModel.GetAttachCandidates();
            }
            @if (ViewModel.SearchAttachCommand.IsRunning)
            {
                <LoadingSpinner />
            }
            else if (attachCandidates.Count == 0)
            {
                <div class="app-empty">@L["Attach_NoResults"]</div>
            }
            else
            {
                <ul class="app-list app-list-bordered">
                    @foreach (Document candidate in attachCandidates)
                    {
                        <li class="app-list-item" @key="candidate.Id">
                            <span class="app-mono fw-semibold" title="@candidate.Number">@DisplayFormat.ShortNumber(candidate.Number)</span>
                            <span>@L.Label(candidate.Type)</span>
                            <span class="app-hint">@DisplayFormat.OrDash(candidate.Customer.Name)</span>
                            <StatusBadge Status="candidate.Status" />
                            <button type="button" class="btn btn-sm btn-primary ms-auto" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.AttachAsync(candidate)">@L["Action_Link"]</button>
                        </li>
                    }
                </ul>
            }
        </ChildContent>
    </ModalDialog>
}
