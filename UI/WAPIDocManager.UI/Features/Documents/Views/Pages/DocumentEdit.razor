@attribute [Route(AppRoutes.RouteTemplates.DocumentEdit)]
@attribute [Authorize(Roles = AppRoles.Writers)]
@using WAPIDocManager.UI.Features.Documents.ViewModels
@* la base di Blazing.Mvvm inietta il ViewModel come ViewModel e ridisegna la pagina a ogni notifica *@
@inherits Blazing.Mvvm.Components.MvvmComponentBase<DocumentEditViewModel>
@inject NavigationManager Navigation
@inject ReturnUrlResolver ReturnUrlResolver

@*
    Modifica documento: GET per precompilare il form, poi PUT api/v1/documents/{id} (ruoli Editor, Admin).
    - Logica in DocumentEditViewModel (stessa cartella della view): caricamento, modello del form, salvataggio.
    - Consentita solo in Draft/Ready (DocumentRules.CanEdit): negli altri stati si mostra un avviso invece del form,
      perché il server risponderebbe comunque 400.
    - In Ready il server rivalida il documento: rimuovere cliente o righe obbligatorie produce un 400 mostrato nella pagina.
    - Il documento viene ricaricato a ogni cambio di Id (OnParametersSetAsync); dopo il salvataggio si torna al dettaglio.
    - Route e link da AppRoutes (Shared/Navigation).
*@

<PageTitle>@L["DocumentEdit_Title"] · @L["App_Name"]</PageTitle>

<div class="app-back"><a href="@_backUrl">← @L["Action_Back"]</a></div>

<div class="app-page-header">
    <div>
        @if (ViewModel.Document is not null)
        {
            <div class="app-eyebrow">@L.Label(ViewModel.Document.Type)</div>
        }
        <h1 class="app-title d-flex flex-wrap align-items-center gap-2">
            <span>@L["DocumentEdit_Title"]</span>
            @if (ViewModel.Document is not null)
            {
                <span class="app-mono">@DisplayFormat.ShortNumber(ViewModel.Document.Number)</span>
                <StatusBadge Status="ViewModel.Document.Status" />
            }
        </h1>
    </div>
</div>

@if (ViewModel.IsLoading)
{
    <LoadingSpinner />
}
else if (ViewModel.Document is null)
{
    <ApiErrorAlert Error="ViewModel.Error" />
}
else if (!DocumentRules.CanEdit(ViewModel.Document.Status))
{
    <div class="alert alert-warning" role="alert">@L["DocumentEdit_NotEditable", L.Label(ViewModel.Document.Status)]</div>
}
else
{
    <ApiErrorAlert Error="ViewModel.Error" OnDismiss="() => ViewModel.Error = null" />
    <DocumentForm Model="ViewModel.Model" IsEdit="true" Busy="ViewModel.IsBusy" OnValidSubmit="SaveAsync" OnCancel="Cancel" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    /// <summary>
    /// Pagina da cui si è aperta la modifica, passata da chi crea il link (oggi la lista documenti).
    /// Assente quando si arriva dal dettaglio, che è anche la destinazione predefinita.
    /// </summary>
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    // Indietro e Annulla tornano dove si era. Il valore arriva dalla query string, quindi è validato all'arrivo
    // dal resolver (stessa protezione del returnUrl del login), una volta sola invece che a ogni render.
    // Il salvataggio invece porta sempre al dettaglio, perché dopo aver salvato si vuole vedere il documento aggiornato.
    private string _backUrl = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _backUrl = ReturnUrlResolver.Resolve(ReturnUrl, AppRoutes.GetDocumentDetail(Id));

        await ViewModel.LoadAsync(Id);
    }

    private async Task SaveAsync()
    {
        if (await ViewModel.SaveAsync(Id))
        {
            Navigation.NavigateTo(AppRoutes.GetDocumentDetail(Id));
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(_backUrl);
    }
}
