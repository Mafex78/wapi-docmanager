@attribute [Route(AppRoutes.RouteTemplates.DocumentEdit)]
@attribute [Authorize(Roles = AppRoles.Writers)]
@using WAPIDocManager.UI.Features.Documents.ViewModels
@* la classe base fornisce il ViewModel e ridisegna la pagina a ogni sua notifica *@
@inherits Blazing.Mvvm.Components.MvvmComponentBase<DocumentEditViewModel>
@inject NavigationManager Navigation
@inject ReturnUrlResolver ReturnUrlResolver

@*
    Modifica di un documento: prima lo si legge per precompilare il form, poi lo si salva.
    - La modifica è consentita solo finché il documento è in bozza o pronto. Negli altri stati si mostra un avviso
      al posto del form, perché il server rifiuterebbe comunque il salvataggio.
    - Su un documento già pronto il server rivalida tutto: togliere il cliente o le righe obbligatorie fa fallire il
      salvataggio, e l'errore viene mostrato nella pagina.
    - Il documento viene riletto a ogni cambio di identificativo; dopo il salvataggio si va al dettaglio.
*@

<PageTitle>@L["DocumentEdit_Title"] · @L["App_Name"]</PageTitle>

<div class="app-back"><a href="@_backUrl">← @L["Action_Back"]</a></div>

<div class="app-page-header">
    <div>
        @if (ViewModel.Document is not null)
        {
            <div class="app-eyebrow">@L.Label(ViewModel.Document.Type)</div>
        }
        <h1 class="app-title d-flex flex-wrap align-items-center gap-2">
            <span>@L["DocumentEdit_Title"]</span>
            @if (ViewModel.Document is not null)
            {
                <span class="app-mono">@DisplayFormat.ShortNumber(ViewModel.Document.Number)</span>
                <StatusBadge Status="ViewModel.Document.Status" />
            }
        </h1>
    </div>
</div>

@if (ViewModel.IsLoading)
{
    <LoadingSpinner />
}
else if (ViewModel.Document is null)
{
    <ApiErrorAlert Error="ViewModel.Error" />
}
else if (!DocumentRules.CanEdit(ViewModel.Document.Status))
{
    <div class="alert alert-warning" role="alert">@L["DocumentEdit_NotEditable", L.Label(ViewModel.Document.Status)]</div>
}
else
{
    <ApiErrorAlert Error="ViewModel.Error" OnDismiss="() => ViewModel.Error = null" />
    <DocumentForm Model="ViewModel.Model" IsEdit="true" Busy="ViewModel.IsBusy" OnValidSubmit="SaveAsync" OnCancel="Cancel" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    /// Pagina da cui la modifica è stata aperta, dichiarata da chi ha costruito il collegamento.
    /// È assente quando si arriva dal dettaglio, che è anche la destinazione predefinita.
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    // Indietro e Annulla riportano da dove si è arrivati. Il valore viene dalla query string, quindi è validato
    // all'arrivo del parametro, una volta sola invece che a ogni ridisegno.
    // Il salvataggio invece porta sempre al dettaglio: dopo aver salvato si vuole vedere il documento aggiornato.
    private string _backUrl = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _backUrl = ReturnUrlResolver.Resolve(ReturnUrl, AppRoutes.GetDocumentDetail(Id));

        await ViewModel.LoadAsync(Id);
    }

    private async Task SaveAsync()
    {
        if (await ViewModel.SaveAsync(Id))
        {
            Navigation.NavigateTo(AppRoutes.GetDocumentDetail(Id));
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(_backUrl);
    }
}
