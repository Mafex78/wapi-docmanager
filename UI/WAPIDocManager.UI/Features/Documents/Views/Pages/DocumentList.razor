@attribute [Route(AppRoutes.RouteTemplates.Documents)]
@attribute [Authorize(Roles = AppRoles.Readers)]
@using WAPIDocManager.UI.Features.Documents.ViewModels
@* la classe base fornisce il ViewModel e ridisegna la pagina a ogni sua notifica *@
@inherits Blazing.Mvvm.Components.MvvmComponentBase<DocumentListViewModel>

@*
    Elenco dei documenti. Ricerca, filtri, paginazione ed eliminazione stanno nel ViewModel; qui restano markup,
    permessi e testi. Ruoli e spiegazioni dei pulsanti disattivati stanno nel file di codice affiancato.
    - I filtri sono legati all'istanza condivisa che sopravvive alla navigazione, quindi tornando dal dettaglio si
      ritrova la ricerca di prima. Cerca riparte dalla prima pagina, Azzera sostituisce l'istanza.
    - Tipologie e stati sono pulsanti che accendono e spengono un valore del filtro, non elenchi a scelta singola.
    - Le azioni di riga sono sempre visibili: quando non sono consentite restano disattivate e spiegano il perché,
      invece di sparire. Un pulsante che compare e scompare è più disorientante di uno inerte che si giustifica.
    - La spiegazione è appesa al contenitore e non al pulsante, perché un pulsante disattivato non riceve gli eventi
      del mouse e il suggerimento non comparirebbe mai. Per la stessa ragione la modifica non consentita è un
      pulsante e non un collegamento: un collegamento non si può disattivare.
    - L'eliminazione chiede conferma; se dopo averla eseguita la pagina corrente resta vuota, si torna all'ultima
      disponibile.
    - Il numero del documento è mostrato abbreviato, con il valore completo come descrizione del collegamento.
*@

<PageTitle>@L["Documents_Title"] · @L["App_Name"]</PageTitle>

<div class="app-page-header">
    <div>
        <h1 class="app-title">@L["Documents_Title"]</h1>
        <p class="app-subtitle">@L["Documents_Subtitle"]</p>
    </div>
    @if (DocumentPermissions.CanWrite(_roles))
    {
        <a class="btn btn-primary" href="@AppRoutes.PageRelativeUrls.DocumentNew">+ @L["Nav_NewDocument"]</a>
    }
</div>

<section class="app-card">
    <EditForm Model="ViewModel.Filter" OnValidSubmit="ViewModel.SearchAsync">
        <FluentValidator />
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="filter-text">@L["Filter_PlainText"]</label>
                <InputText id="filter-text" class="form-control" placeholder="@L["Filter_PlainText_Placeholder"]" @bind-Value="ViewModel.Filter.PlainText" />
            </div>
            <div class="col-md-6 col-lg-3">
                <label class="form-label" for="filter-customer">@L["Filter_Customer"]</label>
                <InputText id="filter-customer" class="form-control" @bind-Value="ViewModel.Filter.CustomerName" />
            </div>
            <div class="col-sm-4 col-lg-2">
                <label class="form-label" for="filter-sort">@L["Filter_SortBy"]</label>
                <InputSelect id="filter-sort" class="form-select" @bind-Value="ViewModel.Filter.SortBy">
                    @foreach (string field in DocumentSortFields.All)
                    {
                        <option value="@field">@L.SortFieldLabel(field)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-sm-4 col-lg-2">
                <label class="form-label" for="filter-direction">@L["Filter_Direction"]</label>
                <InputSelect id="filter-direction" class="form-select" @bind-Value="ViewModel.Filter.SortDirection">
                    @foreach (SortDirection direction in Enum.GetValues<SortDirection>())
                    {
                        <option value="@direction">@L.Label(direction)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-sm-4 col-lg-2">
                <label class="form-label" for="filter-page-size">@L["Filter_PageSize"]</label>
                <InputSelect id="filter-page-size" class="form-select" @bind-Value="ViewModel.Filter.PageSize">
                    <option value="10">10</option>
                    <option value="@DocumentFilter.MaxPageSize">@DocumentFilter.MaxPageSize</option>
                </InputSelect>
            </div>

            <div class="col-lg-6">
                <span class="form-label d-block">@L["Filter_Types"]</span>
                <div class="app-chips">
                    @foreach (DocumentType type in Enum.GetValues<DocumentType>())
                    {
                        bool active = ViewModel.Filter.Types.Contains(type);
                        <button type="button" class="btn btn-sm app-chip @(active ? "active" : null)" aria-pressed="@(active ? "true" : "false")" @onclick="() => ViewModel.ToggleType(type)">
                            @L.Label(type)
                        </button>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <span class="form-label d-block">@L["Filter_Statuses"]</span>
                <div class="app-chips">
                    @foreach (DocumentStatus status in Enum.GetValues<DocumentStatus>())
                    {
                        bool active = ViewModel.Filter.Statuses.Contains(status);
                        <button type="button" class="btn btn-sm app-chip @(active ? "active" : null)" aria-pressed="@(active ? "true" : "false")" @onclick="() => ViewModel.ToggleStatus(status)">
                            @L.Label(status)
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="app-form-actions">
            @* disattivati mentre la ricerca è in corso: la condizione la conosce il comando, non va ripetuta qui *@
            <button type="button" class="btn btn-outline-secondary" disabled="@(!ViewModel.LoadCommand.CanExecute(null))" @onclick="ViewModel.ResetAsync">@L["Action_Reset"]</button>
            <button type="submit" class="btn btn-primary" disabled="@(!ViewModel.LoadCommand.CanExecute(null))">@L["Action_Search"]</button>
        </div>
    </EditForm>
</section>

<ApiErrorAlert Error="ViewModel.Error" OnDismiss="() => ViewModel.Error = null" />

<section class="app-card app-card-flush">
    @if (ViewModel.IsLoading)
    {
        <LoadingSpinner />
    }
    else if (ViewModel.Result.Items.Count == 0)
    {
        <div class="app-empty">@L["Documents_Empty"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@L["Field_Number"]</th>
                        <th scope="col">@L["Field_Type"]</th>
                        <th scope="col">@L["Field_Date"]</th>
                        <th scope="col">@L["Field_Customer"]</th>
                        <th scope="col">@L["Field_Status"]</th>
                        <th scope="col" class="text-end">@L["Field_Total"]</th>
                        <th scope="col" class="text-end"><span class="visually-hidden">@L["Field_Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Document document in ViewModel.Result.Items)
                    {
                        PermissionDenialReason editDenial = DocumentPermissions.GetEditDenialReason(_roles, document.Status);
                        PermissionDenialReason deleteDenial = DocumentPermissions.GetDeleteDenialReason(_roles, document.Status);

                        <tr @key="document.Id">
                            <td><a class="app-mono fw-semibold" href="@AppRoutes.GetDocumentDetail(document.Id)" title="@document.Number">@DisplayFormat.ShortNumber(document.Number)</a></td>
                            <td>@L.Label(document.Type)</td>
                            <td class="text-nowrap">@DisplayFormat.Date(document.Date)</td>
                            <td>@DisplayFormat.OrDash(document.Customer.Name)</td>
                            <td><StatusBadge Status="document.Status" /></td>
                            <td class="text-end text-nowrap">@DisplayFormat.Money(document.Total)</td>
                            <td class="text-end">
                                <div class="app-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary" href="@AppRoutes.GetDocumentDetail(document.Id)">@L["Action_View"]</a>
                                    @if (editDenial == PermissionDenialReason.None)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@AppRoutes.GetDocumentEdit(document.Id, AppRoutes.PageRelativeUrls.Documents)">@L["Action_Edit"]</a>
                                    }
                                    else
                                    {
                                        <span class="app-disabled-action" title="@EditDenialMessage(editDenial, document.Status)">
                                            <button type="button" class="btn btn-sm btn-outline-primary" disabled>@L["Action_Edit"]</button>
                                        </span>
                                    }
                                    @if (deleteDenial == PermissionDenialReason.None)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ViewModel.DocumentToDelete = document">@L["Action_Delete"]</button>
                                    }
                                    else
                                    {
                                        <span class="app-disabled-action" title="@DeleteDenialMessage(deleteDenial, document.Status)">
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled>@L["Action_Delete"]</button>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="app-table-footer">
            <span>@L["Documents_Found", ViewModel.Result.TotalItems]</span>
            <Pager CurrentPage="ViewModel.Result.CurrentPage" TotalPages="ViewModel.Result.TotalPages" Disabled="@(!ViewModel.LoadCommand.CanExecute(null))" OnPageChanged="ViewModel.GoToPageAsync" />
        </div>
    }
</section>

<ModalDialog IsOpen="ViewModel.DocumentToDelete is not null" Title="@L["Delete_Title"]" OnClose="() => ViewModel.DocumentToDelete = null">
    <ChildContent>
        <p class="mb-0">@L["Delete_Message", DisplayFormat.ShortNumber(ViewModel.DocumentToDelete?.Number)]</p>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => ViewModel.DocumentToDelete = null">@L["Action_Cancel"]</button>
        <button type="button" class="btn btn-danger" disabled="@ViewModel.IsDeleting" @onclick="ViewModel.DeleteAsync">@L["Action_Delete"]</button>
    </FooterContent>
</ModalDialog>
