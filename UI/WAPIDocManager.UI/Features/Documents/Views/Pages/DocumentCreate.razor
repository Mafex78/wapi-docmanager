@attribute [Route(AppRoutes.RouteTemplates.DocumentNew)]
@attribute [Authorize(Roles = AppRoles.Writers)]
@inject IDocumentService DocumentService
@inject NavigationManager Navigation

@*
    Creazione di un documento.
    Il form parte senza righe: una riga vuota bloccherebbe subito il salvataggio, perché non supererebbe la
    validazione.
    Il server crea il documento in bozza con la data odierna, e a salvataggio riuscito si apre il suo dettaglio.
    Nota sull'indirizzo: la pagina di creazione ha la precedenza su quella di dettaglio perché il suo ultimo
    segmento è fisso, mentre l'altra ha un parametro.
*@

<PageTitle>@L["DocumentCreate_Title"] · @L["App_Name"]</PageTitle>

<div class="app-back"><a href="@AppRoutes.PageRelativeUrls.Documents">← @L["Action_Back"]</a></div>

<div class="app-page-header">
    <div>
        <h1 class="app-title">@L["DocumentCreate_Title"]</h1>
        <p class="app-subtitle">@L["DocumentCreate_Subtitle"]</p>
    </div>
</div>

<ApiErrorAlert Error="_error" OnDismiss="() => _error = null" />

<DocumentForm Model="_model" Busy="_busy" OnValidSubmit="SaveAsync" OnCancel="Cancel" />

@code {
    private readonly DocumentEditModel _model = new();
    private Exception? _error;
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            Document created = await DocumentService.CreateAsync(_model);
            Navigation.NavigateTo(AppRoutes.GetDocumentDetail(created.Id));
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(AppRoutes.PageRelativeUrls.Documents);
    }
}
