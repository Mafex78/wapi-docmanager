@attribute [Route(AppRoutes.RouteTemplates.Home)]
@inject NavigationManager Navigation

@* Root dell'applicazione: reindirizza alla lista documenti (se l'utente non è autenticato interviene prima RedirectToLogin). *@

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo(AppRoutes.PageRelativeUrls.Documents, replace: true);
    }
}
