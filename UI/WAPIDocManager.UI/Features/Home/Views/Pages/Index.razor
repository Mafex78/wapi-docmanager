@attribute [Route(AppRoutes.RouteTemplates.Home)]
@inject NavigationManager Navigation

@* Radice dell'applicazione: manda all'elenco documenti. Se l'utente non è autenticato viene intercettato prima. *@

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo(AppRoutes.PageRelativeUrls.Documents, replace: true);
    }
}
