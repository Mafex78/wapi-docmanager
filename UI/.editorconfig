#### [PERSONALIZZATO] Altri tipi di file della solution ####
# Il template dell'SDK copre solo .cs/.vb (più .xml): queste sezioni allineano il resto a come i file sono
# già scritti oggi, così l'IDE non li riformatta con i propri default.

# Componenti Blazor
[*.razor]
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true

# File di progetto e di build (MSBuild): .csproj, Directory.Build.props, Directory.Packages.props, .slnx
[*.{csproj,props,targets,slnx}]
indent_size = 4
tab_width = 4

# Risorse di localizzazione: generate dall'IDE con rientro a 2
[*.resx]
indent_size = 2

# Asset statici di wwwroot e configurazione del client
[*.{css,js,html,json}]
indent_size = 4
tab_width = 4

#### [PERSONALIZZATO] Severità di singole regole degli analizzatori ####
# Ogni voce qui sotto disattiva una regola in un punto preciso e spiega il perché: una soppressione senza motivo
# è peggio del warning. Per rivedere una scelta basta rimuovere la riga e ricompilare.

[*.{cs,vb}]
# CA1716: segnala i namespace che coincidono con parole chiave riservate. Le segnalazioni riguardano tutte
# "Shared" (WAPIDocManager.UI.Shared.*), che è keyword in VB.NET: la solution è solo C#, nessun rischio.
dotnet_diagnostic.CA1716.severity = none

# Marker delle risorse localizzate: deve restare una classe vuota nella root del progetto (vedi commento nel file),
# altrimenti cambia il nome della risorsa incorporata e i testi diventano chiavi.
[WAPIDocManager.UI/SharedResource.cs]
# S2094: "rimuovi la classe vuota"
dotnet_diagnostic.S2094.severity = none

# Route dell'applicazione: AppRoutes.Templates.Login (template con slash) e AppRoutes.Login (link relativo)
# hanno lo stesso nome di proposito, così i due usi si leggono in parallelo.
[WAPIDocManager.UI/Shared/Navigation/AppRoutes.cs]
# S3218: "il campo nasconde un membro della classe esterna"
dotnet_diagnostic.S3218.severity = none

# Progetti di test: convenzioni proprie di xUnit/Moq, diverse da quelle del codice di produzione.
[Tests/**/*.cs]
# CA1707: i nomi dei test seguono lo schema Metodo_Scenario_RisultatoAtteso, gli underscore sono voluti.
dotnet_diagnostic.CA1707.severity = none
# CA1861: array costanti passati come argomento; è una regola di prestazioni, in un test non ha effetto utile.
dotnet_diagnostic.CA1861.severity = none
# Moq1400: impone di dichiarare il MockBehavior. Il comportamento usato è quello predefinito (Loose) e ripeterlo
# in ogni mock aggiunge rumore; le altre regole di Moq.Analyzers restano attive.
dotnet_diagnostic.Moq1400.severity = none
